{
  "name": "inertia-page-loader",
  "type": "module",
  "version": "0.9.0",
  "packageManager": "pnpm@10.12.1",
  "description": "The plugin page loader for Inertia.js",
  "author": "Lucas Yang <yangchenshin77@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/ycs77/inertia-page-loader#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ycs77/inertia-page-loader.git"
  },
  "bugs": {
    "url": "https://github.com/ycs77/inertia-page-loader/issues"
  },
  "keywords": [
    "inertia",
    "inertiajs",
    "unplugin",
    "vite",
    "webpack",
    "rollup",
    "transform"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./farm": {
      "import": {
        "types": "./dist/farm.d.mts",
        "default": "./dist/farm.mjs"
      },
      "require": {
        "types": "./dist/farm.d.cts",
        "default": "./dist/farm.cjs"
      }
    },
    "./rollup": {
      "import": {
        "types": "./dist/rollup.d.mts",
        "default": "./dist/rollup.mjs"
      },
      "require": {
        "types": "./dist/rollup.d.cts",
        "default": "./dist/rollup.cjs"
      }
    },
    "./rspack": {
      "import": {
        "types": "./dist/rspack.d.mts",
        "default": "./dist/rspack.mjs"
      },
      "require": {
        "types": "./dist/rspack.d.cts",
        "default": "./dist/rspack.cjs"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime.d.mts",
        "default": "./dist/runtime.mjs"
      },
      "require": {
        "types": "./dist/runtime.d.cts",
        "default": "./dist/runtime.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.mts",
        "default": "./dist/types.mjs"
      },
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.mts",
        "default": "./dist/vite.mjs"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    },
    "./webpack": {
      "import": {
        "types": "./dist/webpack.d.mts",
        "default": "./dist/webpack.mjs"
      },
      "require": {
        "types": "./dist/webpack.d.cts",
        "default": "./dist/webpack.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "unpkg": "./dist/runtime.iife.js",
  "jsdelivr": "./dist/runtime.iife.js",
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "files": [
    "*.d.ts",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "build:fix": "tsx scripts/postbuild.ts",
    "dev": "tsdown -w",
    "lint": "eslint .",
    "play": "npm -C playground run dev",
    "prepublishOnly": "npm run build",
    "release": "bumpp --commit \"Release v%s\" && pnpm publish",
    "start": "tsx src/index.ts",
    "test": "vitest"
  },
  "peerDependencies": {
    "@farmfe/core": ">=1",
    "@inertiajs/core": ">=1",
    "rollup": "^3",
    "vite": ">=3",
    "webpack": "^4 || ^5"
  },
  "peerDependenciesMeta": {
    "@farmfe/core": {
      "optional": true
    },
    "@inertiajs/core": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "dependencies": {
    "debug": "^4.4.1",
    "fast-glob": "^3.3.3",
    "unplugin": "^2.3.5"
  },
  "devDependencies": {
    "@swc/core": "^1.11.31",
    "@types/debug": "^4.1.12",
    "@types/node": "^22.15.31",
    "@ycs77/eslint-config": "^4.3.0",
    "bumpp": "^10.1.1",
    "eslint": "^9.28.0",
    "npm-run-all2": "^8.0.4",
    "rollup": "^4.42.0",
    "tsdown": "^0.12.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.3",
    "webpack": "^5.99.9"
  }
}
